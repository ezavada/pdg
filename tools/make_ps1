}

# Function to build Node.js library
function Build-Node {
    param(
        [string]$Config,
        [string]$MSBUILD_PATH,
        [switch]$Verbose
    )
    
    Write-Status "Checking Node.js library..." "Cyan"
    if (-not (Ensure-RepoSubmodule -RepoRoot $PSScriptRoot -SubmodulePath "deps/node" -SentinelRelativePath "deps\node\src\node_version.h" -DisplayName "Node.js source checkout")) {
        Write-Error-Status "Node.js source checkout is required to build the node target."
        return 1
    }
    $nodeLibPath = "$PdgNodeOutDir\$Config\lib\libnode.lib"
    $nodeBaseLibPath = "$PdgNodeOutDir\$Config\lib\node_base.lib"
    $nodeExePath = "$PdgNodeOutDir\$Config\node.exe"
    $nodeVersionHeader = "deps\node\src\node_version.h"
    $nodeVersionStamp = "$PdgNodeOutDir\$Config\.pdg-node-version.h"
    $nodeVersionParts = [regex]::Matches((Get-Content $nodeVersionHeader -Raw),
        '(?m)^#define NODE_(?:MAJOR|MINOR|PATCH)_VERSION (\d+)')
    $nodeExpectedVersion = 'v' + (($nodeVersionParts | ForEach-Object { $_.Groups[1].Value }) -join '.')

    # Require the executable, both core libraries, and matching version metadata.
    $nodeLibExists = (Test-Path $nodeLibPath) -and (Test-Path $nodeBaseLibPath)
    $nodeExeExists = Test-Path $nodeExePath
    $nodeVersionMatches = (Test-Path $nodeVersionStamp) -and
        ((Get-FileHash $nodeVersionHeader).Hash -eq (Get-FileHash $nodeVersionStamp).Hash)
    $nodeVersionMatches = $nodeVersionMatches -and $nodeExeExists -and
        ((& $nodeExePath --version) -eq $nodeExpectedVersion)

    if (-not $nodeLibExists -or -not $nodeExeExists -or -not $nodeVersionMatches) {
        Write-Status "Building Node.js as a library..." "Yellow"
        Remove-Item $nodeVersionStamp -Force -ErrorAction SilentlyContinue
        $pythonPath = Find-NodePython
        if ($pythonPath) {
            Add-NodePythonPath -PythonPath $pythonPath
        }
        else {
            Write-Warning-Status "Could not find Python 3.9-3.14 before running Node.js vcbuild.bat"
        }
        
        Push-Location "deps\node"
        try {
            # Keep the build single-threaded, but let vcbuild regenerate project files when needed.
            Write-Status "Running: cmd /c vcbuild.bat nosign" "Gray"
            Write-Status "Using single-threaded build to prevent MSBuild hanging issues" "Yellow"
            $originalProcessors = $env:NUMBER_OF_PROCESSORS
            $env:NUMBER_OF_PROCESSORS = "1"
            $process = Start-Process -FilePath "cmd" -ArgumentList @("/c", "vcbuild.bat", "nosign") -PassThru -NoNewWindow
            $timeout = 60 * 60 * 1000  # 60 minutes timeout for single-threaded Node.js build
            # Open the process handle before a timed wait so ExitCode remains available
            # in Windows PowerShell after the process exits.
            $null = $process.Handle
            
            if ($process.WaitForExit($timeout)) {
                $BUILD_STATUS = $process.ExitCode
            } else {
                Write-Error-Status "Node.js build timed out after 60 minutes. Terminating process..."
                $process.Kill()
                $process.WaitForExit(10000)  # Wait up to 10 seconds for graceful termination
                if (!$process.HasExited) {
                    Write-Warning-Status "Process did not terminate gracefully, forcing kill..."
                    Stop-Process -Id $process.Id -Force
                }
                $BUILD_STATUS = 1
            }
            
            # Restore original processor count
            $env:NUMBER_OF_PROCESSORS = $originalProcessors
            
            if ($BUILD_STATUS -eq 0) {
                # Copy library files
                if (Test-Path "$Config\lib\*.lib") {
                    Copy-Item "$Config\lib\*.lib" "out\$Config\" -Force
                }
                if (Test-Path "build\$Config\lib\*.lib") {
                    Copy-Item "build\$Config\lib\*.lib" "out\$Config\" -Force
                }
            }
        }
        finally {
            Pop-Location
        }
        
        # Verify Node.js build actually succeeded by checking for required files
        $requiredFiles = @(
            "$PdgNodeOutDir\$Config\lib\libnode.lib",
            "$PdgNodeOutDir\$Config\lib\node_base.lib",
            "$PdgNodeOutDir\$Config\node.exe"
        )
        
        $buildActuallySucceeded = $BUILD_STATUS -eq 0
        foreach ($file in $requiredFiles) {
            if (-not (Test-Path $file)) {
                Write-Error-Status "Required Node.js file missing: $file"
                $buildActuallySucceeded = $false
            }
        }
        if ($buildActuallySucceeded -and ((& $nodeExePath --version) -ne $nodeExpectedVersion)) {
            Write-Error-Status "Node.js build does not match source version $nodeExpectedVersion"
            $buildActuallySucceeded = $false
        }
        
        if ($buildActuallySucceeded) {
            Write-Success-Status "Node.js build verification passed - all required files present"
            Copy-Item $nodeVersionHeader $nodeVersionStamp -Force
        } else {
            Write-Error-Status "Node.js build verification failed (vcbuild exit code: $BUILD_STATUS)"
            $BUILD_STATUS = 1
        }
        
        if ($BUILD_STATUS -ne 0) {
            Write-Error-Status "Node.js build failed"
            return 1
        }
        
        # Clean up after Node.js build
        Cleanup-BuildProcesses
    }
    else {
        Write-Status "Using cached Node.js build matching the source version:" "Green"
        Write-Status "   libnode.lib" "Gray"
        Write-Status "   node.exe" "Gray"
    }

    # Refresh the tool after a version upgrade as well as on the first build.
    $null = Copy-File-If-Exists $nodeExePath "tools\node.exe"
    
    return 0
}

# Function to build the PDG Node.js module package
function Build-PDG-Node {
    param(
        [string]$Config,
        [string]$MSBUILD_PATH,
        [switch]$Verbose
    )

    Write-Host ""
    Write-Status "Building PDG Node.js module..." "Cyan"

    $status = Build-Node -Config $Config -MSBUILD_PATH $MSBUILD_PATH -Verbose:$Verbose
    if ($status -ne 0) { return $status }

    $moduleScript = Join-Path $PDG_ROOT "tools\make-node-module.ps1"
    if (-not (Test-Path $moduleScript)) {
        Write-Error-Status "Missing script: $moduleScript"
        return 1
    }

    try {
        & $moduleScript -Config $Config | Out-Host
        if ($LASTEXITCODE -ne 0) {
            Write-Error-Status "PDG Node.js module build failed with exit code $LASTEXITCODE"
            return 1
        }
    }
    catch {
        Write-Error-Status "PDG Node.js module build failed: $($_.Exception.Message)"
        return 1
    }

    Write-Host ""
    Write-Success-Status "PDG Node.js module built successfully!"
    return 0
}

# Function to build GLFW library
function Build-GLFW {
    param(
        [string]$Config,
        [string]$MSBUILD_PATH,
        [switch]$Verbose
    )

    if ($script:PDG_HEADLESS_BUILD) {
        Write-Status "Skipping GLFW build because the current PDG configuration is headless." "Yellow"
        return 0
    }

    if (-not (Test-Path "$PdgBuildRoot\glfw\GLFW.sln")) {
        Write-Error-Status "GLFW is not configured. Run .\configure.ps1 without -Headless to generate the GLFW solution."
        return 1
    }

    Write-Status "Building GLFW Library..." "Yellow"
    Push-Location "$PdgBuildRoot\glfw"
    try {
        $BUILD_STATUS = Invoke-MSBuild -ProjectPath "GLFW.sln" -Target "Build" -Configuration $Config -MSBuildPath $MSBUILD_PATH -Verbose:$Verbose
        
        if ($BUILD_STATUS -eq 0) {
            # Copy glfw3.lib to src directory
            $null = Copy-File-If-Exists "src\$Config\glfw3.lib" "src\glfw3.lib"
        }
    }
    finally {
        Pop-Location
    }

    # Verify GLFW build actually succeeded by checking for the library file
    $glfwLibPath = "$PdgBuildRoot\glfw\src\$Config\glfw3.lib"
    if ($BUILD_STATUS -eq 0 -and (Test-Path $glfwLibPath)) {
        Write-Success-Status "GLFW build verification passed - glfw3.lib exists"
    } elseif ($BUILD_STATUS -eq 0) {
        Write-Error-Status "GLFW build verification failed - glfw3.lib not found"
        $BUILD_STATUS = 1
    }

    if ($BUILD_STATUS -ne 0) {
        Write-Error-Status "GLFW build failed"
        return 1
    }

    # Clean up after GLFW build
    Cleanup-BuildProcesses
    return 0
}

# Function to build Chipmunk library
function Build-Chipmunk {
    param(
        [string]$Config,
        [string]$MSBUILD_PATH,
        [switch]$Verbose
    )
    
    Write-Status "Building Chipmunk Library..." "Yellow"
    Push-Location "$PdgBuildRoot\chipmunk"
    try {
        $BUILD_STATUS = Invoke-MSBuild -ProjectPath "chipmunk.sln" -Target "Build" -Configuration $Config -MSBuildPath $MSBUILD_PATH -Verbose:$Verbose
    }
    finally {
        Pop-Location
    }

    # Verify Chipmunk build actually succeeded by checking for the library file
    $chipmunkLibPath = "$PdgBuildRoot\chipmunk\src\$Config\chipmunk.lib"
    if ($BUILD_STATUS -eq 0 -and (Test-Path $chipmunkLibPath)) {
        Write-Success-Status "Chipmunk build verification passed - chipmunk.lib exists"
    } elseif ($BUILD_STATUS -eq 0) {
        Write-Error-Status "Chipmunk build verification failed - chipmunk.lib not found"
        $BUILD_STATUS = 1
    }

    if ($BUILD_STATUS -ne 0) {
        Write-Error-Status "Chipmunk build failed"
        return 1
    }

    # Copy chipmunk.lib to src directory
    $null = Copy-File-If-Exists "$PdgBuildRoot\chipmunk\src\$Config\chipmunk.lib" "$PdgBuildRoot\chipmunk\src\chipmunk.lib"

    # Clean up after Chipmunk build
    Cleanup-BuildProcesses
    return 0
}

