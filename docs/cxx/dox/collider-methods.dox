/**
\fn bool pdg::Collider::isPresent() const
\brief Test whether this is a real collider.

\return False only for the shared NoCollider object.
*/

/**
\fn bool pdg::Collider::isAttached() const
\brief Test whether this collider still has an owner.

Removal detaches a retained collider; queries continue to use its last transform.

\return Whether an owner still supplies its transform.
*/

/**
\fn uint64_t pdg::Collider::getId() const
\brief Read this collider’s process-local identity.

IDs are independent of shape IDs and are not persistent save-game identifiers.

\return A nonzero identity, or zero for NoCollider.
*/

/**
\fn Collider& pdg::Collider::setEnabled(bool enabled)
\brief Enable or suspend participation in collision worlds.

Disabling preserves geometry and explicit geometric queries. Existing contacts end on the next world update.

\param enabled Whether this collider participates. Defaults to true on creation.

\return This object, for chaining.
*/

/**
\fn bool pdg::Collider::isEnabled() const
\brief Read collision participation.

\return False when disabled or absent.
*/

/**
\fn Collider& pdg::Collider::setSensor(bool sensor)
\brief Choose overlap-only contact reporting.

A sensor never applies a physical response. Enable owner events separately with setWantsContactEvents().

\param sensor True for a sensor; false for a solid. Creation defaults to false.

\return This object, for chaining.
*/

/**
\fn bool pdg::Collider::isSensor() const
\brief Read sensor mode.

\return Whether contacts are overlap-only.
*/

/**
\fn Collider& pdg::Collider::setFriction(double friction)
\brief Override this collider’s contact friction.

The two colliders’ coefficients are multiplied. This overrides the associated body’s material without changing that body.

\param friction Finite nonnegative Coulomb coefficient.

\return This object, for chaining.
*/

/**
\fn Collider& pdg::Collider::setRestitution(double restitution)
\brief Override this collider’s restitution.

The two colliders’ coefficients are multiplied. Zero is inelastic; one preserves normal rebound speed.

\param restitution Finite coefficient from zero through one.

\return This object, for chaining.
*/

/**
\fn double pdg::Collider::getFriction() const
\brief Read the effective contact friction.

Defaults to the associated body’s friction, or one for a bodyless surface.

\return Effective coefficient; zero for NoCollider.
*/

/**
\fn double pdg::Collider::getRestitution() const
\brief Read the effective restitution.

Defaults to the associated body’s restitution, or one for a bodyless surface.

\return Effective coefficient; zero for NoCollider.
*/

/**
\fn Collider& pdg::Collider::useBodyMaterial()
\brief Clear both per-collider material overrides.

Subsequent contacts follow the body’s material; bodyless surfaces use neutral coefficients of one.

\return This object, for chaining.
*/

/**
\fn Collider& pdg::Collider::setCategory(uint32_t category)
\brief Set this collider’s category bits.

A pair requires each collider’s category to intersect the other’s mask. Geometric queries ignore filters.

\param category Unsigned 32-bit bitset. Default is 1.

\return This object, for chaining.
*/

/**
\fn uint32_t pdg::Collider::getCategory() const
\brief Read category bits.

\return Unsigned 32-bit bitset.
*/

/**
\fn Collider& pdg::Collider::setCollisionMask(uint32_t mask)
\brief Set the categories this collider accepts.

A zero mask suppresses contacts. Both endpoints’ masks must accept the other category.

\param mask Unsigned 32-bit bitset. Default accepts all categories.

\return This object, for chaining.
*/

/**
\fn uint32_t pdg::Collider::getCollisionMask() const
\brief Read accepted category bits.

\return Unsigned 32-bit bitset.
*/

/**
\fn Collider& pdg::Collider::setGroup(uint32_t group)
\brief Set an optional collision exclusion group.

Two colliders in the same nonzero group do not collide, regardless of category/mask. Zero disables group exclusion.

\param group Unsigned 32-bit group; default zero.

\return This object, for chaining.
*/

/**
\fn uint32_t pdg::Collider::getGroup() const
\brief Read the collision exclusion group.

\return Unsigned group ID, or zero.
*/

/**
\fn Collider& pdg::Collider::setCircle(double radius, const Point& center = Point())
\brief Replace all geometry with one circle.

Validation occurs before replacing the previous shapes. The new shape receives a fresh ID.

\param radius Finite positive radius in owner-local units.
\param center Finite local center; defaults to the origin.

\return This object, for chaining.
*/

/**
\fn CollisionShapeId pdg::Collider::addCircle(double radius, const Point& center = Point())
\brief Add a local circle.

Existing shape IDs remain unchanged. Shapes follow the owner’s position, rotation, scale and parent transforms.

\param radius Finite positive radius in owner-local units.
\param center Finite local center; defaults to the origin.

\return Stable nonzero shape ID, or collisionShape_None for NoCollider.
*/

/**
\fn Collider& pdg::Collider::setBox(const Rect& bounds)
\brief Replace all geometry with one rectangle.

Validation occurs before replacing the previous shapes. The new shape receives a fresh ID.

\param bounds Finite local bounds with positive width and height.

\return This object, for chaining.
*/

/**
\fn CollisionShapeId pdg::Collider::addBox(const Rect& bounds)
\brief Add a local rectangle.

Existing shape IDs remain unchanged. Shapes follow the owner’s position, rotation, scale and parent transforms.

\param bounds Finite local bounds with positive width and height.

\return Stable nonzero shape ID, or collisionShape_None for NoCollider.
*/

/**
\fn CollisionShapeId pdg::Collider::addPolygon(const std::vector<Point>& vertices)
\brief Add a simple local polygon, including concave outlines.

Copies the outline and decomposes concave regions into convex solver pieces, retaining one public shape ID. Collinear edge points and a repeated closing point are accepted; crossings, touching edges, zero-area outlines and nonfinite points are rejected without changing existing geometry. Basic and Chipmunk use the same decomposition.

\param vertices Three through 4096 finite Points in perimeter order, clockwise or counterclockwise.

\return Stable nonzero shape ID, or collisionShape_None for NoCollider.
*/

/**
\fn bool pdg::Collider::removeShape(CollisionShapeId shape)
\brief Remove one shape by its stable ID.

IDs are never reassigned within a collider. Removing an added shape ends its contacts at the next update. Source-controlled frame/animation shapes cannot be removed individually; attempting that throws. Removing an addition leaves the source active.

\param shape ID returned by an add method or getShapeId().

\return True if a shape was removed; false for an unknown ID or NoCollider.
*/

/**
\fn Collider& pdg::Collider::clearShapes()
\brief Remove every collision shape.

The collider remains attached and keeps its filters, material and body association.

\return This object, for chaining.
*/

/**
\fn uint32_t pdg::Collider::getShapeCount() const
\brief Count the current shapes.

\return Number of shapes; zero for NoCollider.
*/

/**
\fn CollisionShapeId pdg::Collider::getShapeId(uint32_t index) const
\brief Find the stable ID at a current list index.

List indices shift when shapes are removed. An out-of-range index throws.

\param index Zero-based shape index.

\return Stable shape ID.
*/

/**
\fn Rect pdg::Collider::getBounds() const
\brief Compute the union of transformed shape bounds.

Uses owning-layer/world coordinates. Disabled and detached colliders remain queryable.

\return Axis-aligned Rect, or an empty Rect when there are no shapes.
*/

/**
\fn bool pdg::Collider::contains(const Point& worldPoint) const
\brief Test a world point against the geometry.

Ignores enabled/sensor flags and category/mask/group filters. Nonfinite coordinates throw.

\param worldPoint Point in owning-layer/world coordinates.

\return Whether any shape contains or touches the point.
*/

/**
\fn bool pdg::Collider::overlaps(const Collider& other) const
\brief Test two colliders geometrically.

Ignores layers, physical bodies, filters and enabled/sensor flags. Both geometries must be interpreted in the same coordinate system.

\param other Other collider to query.

\return Whether any pair of shapes overlaps or touches.
*/

/**
\fn Collider& pdg::Collider::setPhysicsBody(PhysicsBody& body)
\brief Associate these shapes with an explicit compound body.

Shapes continue to follow their own owner’s transform but transmit impulses to this body. Shapes on the same body do not collide with each other. The body is retained until reset/removal. At world synchronization, removal or transfer of that body resets the association to the owner.

\param body Instantiated PhysicsBody in the same layer/world; NoPhysics is rejected.

\return This object, for chaining.
*/

/**
\fn Collider& pdg::Collider::useOwnerPhysics()
\brief Restore the owner’s current body association.

This is the default. Later setupPhysicsBody()/removePhysicsBody() calls on the owner are followed automatically.

\return This object, for chaining.
*/

/**
\fn PhysicsBody& pdg::Collider::getPhysicsBody() const
\brief Read the effective body association.

Does not allocate or instantiate physics.

\return The explicit compound body, owner’s current body, or shared PhysicsBody.NoPhysics.
*/

/**
\fn Collider& pdg::Collider::setWantsContactEvents(bool wanted)
\brief Enable contact events on the owning Sprite.

Both a Sprite collider and its Parts’ colliders deliver eventType_ColliderContact through that Sprite. Delivery is synchronous after the solve; contacts identify the exact collider and shape. Native contact listeners are independent.

\param wanted True to opt in; default false.

\return This object, for chaining.
*/

/**
\fn bool pdg::Collider::getWantsContactEvents() const
\brief Read owner-event delivery preference.

\return Whether owner events are requested.
*/

/**
\fn const std::string& pdg::Collider::getContactError() const
\brief Read the last native contact-dispatch error.

An exception reaching the native dispatcher is contained; a later successful dispatch clears the message.

\return Diagnostic string, or empty when the last dispatch succeeded.
*/

/**
\fn Collider& pdg::Sprite::setupCollider()
\brief Set up the collision geometry association for this owner.

An existing collider keeps its geometry and settings; use .collider to access it directly. A new collider starts enabled with no shapes, no sensor flag and owner-body association. Does not create a PhysicsBody.

\return The owned collider. Native callers may addRef()/release() to retain it after removal.
*/

/**
\fn void pdg::Sprite::removeCollider()
\brief Remove this owner’s collider.

Idempotent. Restores shared NoCollider, removes native shapes, clears contact callbacks and detaches retained handles. Detached geometric queries preserve the final transform.
*/

/**
\fn Collider& pdg::Part::setupCollider()
\brief Set up the collision geometry association for this owner.

An existing collider keeps its geometry and settings; use .collider to access it directly. A new collider starts enabled with no shapes, no sensor flag and owner-body association. Does not create a PhysicsBody.

\return The owned collider. Native callers may addRef()/release() to retain it after removal.
*/

/**
\fn void pdg::Part::removeCollider()
\brief Remove this owner’s collider.

Idempotent. Restores shared NoCollider, removes native shapes, clears contact callbacks and detaches retained handles. Detached geometric queries preserve the final transform.
*/

/**
\fn int pdg::PhysicsConstraint::getType() const
\brief Read the constraint family.

\return An integer constraint_ constant.
*/

/**
\fn bool pdg::PhysicsConstraint::isActive() const
\brief Test whether the endpoints remain connected.

A connected constraint can be dormant while its owners are outside a layer. This does not promise that a solver has advanced it.

\return False after disconnect, endpoint removal/transfer, or breaking.
*/

/**
\fn bool pdg::PhysicsConstraint::isBroken() const
\brief Test whether the break threshold disconnected this handle.

Manual disconnect does not mark a constraint broken.

\return Whether it broke during a physical solve.
*/

/**
\fn PhysicsBody& pdg::PhysicsConstraint::getBodyA() const
\brief Read endpoint A.

A is the factory receiver; B is the other body.

\return The body, or shared PhysicsBody.NoPhysics after disconnection.
*/

/**
\fn PhysicsBody& pdg::PhysicsConstraint::getBodyB() const
\brief Read endpoint B.

A is the factory receiver; B is the other body.

\return The body, or shared PhysicsBody.NoPhysics after disconnection.
*/

/**
\fn PhysicsConstraint& pdg::PhysicsConstraint::setMaxForce(double force)
\brief Set the maximum constraint force or torque.

Linear constraints use force; angular constraints use torque. Takes effect on the next solve. Both solvers cap the impulse per step to this value times elapsed seconds.

\param force Nonnegative maximum, including positive infinity. Default is infinity except motors.

\return This object, for chaining.
*/

/**
\fn double pdg::PhysicsConstraint::getMaxForce() const
\brief Read the force or torque cap.

\return Nonnegative cap, possibly infinity.
*/

/**
\fn PhysicsConstraint& pdg::PhysicsConstraint::setBreakForce(double force)
\brief Choose the force or torque that breaks this constraint.

The threshold is checked after each solve against impulse divided by elapsed seconds. Breaking disconnects only this constraint, leaving the handle queryable.

\param force Finite nonnegative threshold; zero disables breaking.

\return This object, for chaining.
*/

/**
\fn double pdg::PhysicsConstraint::getBreakForce() const
\brief Read the breaking threshold.

\return Threshold, or zero when breaking is disabled.
*/

/**
\fn PhysicsConstraint& pdg::PhysicsConstraint::setCollideBodies(bool collide)
\brief Allow contacts between connected endpoints.

Defaults to false. Collision masks, groups and layers still apply when enabled. This does not create collision geometry.

\param collide Whether the two bodies may collide.

\return This object, for chaining.
*/

/**
\fn bool pdg::PhysicsConstraint::getCollideBodies() const
\brief Read the connected-body collision preference.

\return Whether this constraint allows its endpoints to collide.
*/

/**
\fn double pdg::PhysicsConstraint::getImpulse() const
\brief Read the latest constraint impulse magnitude.

Linear constraints report momentum impulse; angular constraints report angular impulse.

\return Nonnegative magnitude from the most recent solve.
*/

/**
\fn double pdg::PhysicsConstraint::getForce() const
\brief Read the latest average constraint force or torque.

Computed from the latest impulse divided by elapsed seconds. Zero before a solve.

\return Nonnegative force or torque magnitude.
*/

/**
\fn void pdg::PhysicsConstraint::disconnect()
\brief Disconnect this constraint safely.

Idempotent. Both endpoint lists drop it; a retained handle remains usable and reports NoPhysics endpoints. No implicit reconnection occurs.
*/

/**
\fn PhysicsConstraint& pdg::PhysicsBody::createPinJoint(PhysicsBody& other, const Point& anchor = Point(), const Point& otherAnchor = Point())
\brief Preserve the initial distance between two anchors.

Captures distance at creation. Coincident anchors behave as a pivot. Requires two distinct instantiated bodies in the same world. Anchors are unscaled body-local coordinates, independent of artwork scaling. Basic and Chipmunk implement the same relationship with different numerical trajectories. Endpoints own the active handle; native callers must retain it explicitly to use it after disconnection.

\param other Other instantiated PhysicsBody; may belong to a Sprite or Part.
\param anchor Anchor in this body’s local distance coordinates; default origin where optional.
\param otherAnchor Anchor in the other body’s local distance coordinates; default origin where optional.

\return The new PhysicsConstraint handle.

\see PhysicsConstraint
*/

/**
\fn PhysicsConstraint& pdg::PhysicsBody::createPivotJoint(PhysicsBody& other, const Point& anchor = Point(), const Point& otherAnchor = Point())
\brief Keep two body-local anchors coincident.

The two anchors need not initially coincide. Requires two distinct instantiated bodies in the same world. Anchors are unscaled body-local coordinates, independent of artwork scaling. Basic and Chipmunk implement the same relationship with different numerical trajectories. Endpoints own the active handle; native callers must retain it explicitly to use it after disconnection.

\param other Other instantiated PhysicsBody; may belong to a Sprite or Part.
\param anchor Anchor in this body’s local distance coordinates; default origin where optional.
\param otherAnchor Anchor in the other body’s local distance coordinates; default origin where optional.

\return The new PhysicsConstraint handle.

\see PhysicsConstraint
*/

/**
\fn PhysicsConstraint& pdg::PhysicsBody::createSlideJoint(PhysicsBody& other, const Point& anchor, const Point& otherAnchor, double minDistance, double maxDistance)
\brief Limit the separation of two anchors.

The anchors move freely between the limits. Requires two distinct instantiated bodies in the same world. Anchors are unscaled body-local coordinates, independent of artwork scaling. Basic and Chipmunk implement the same relationship with different numerical trajectories. Endpoints own the active handle; native callers must retain it explicitly to use it after disconnection.

\param other Other instantiated PhysicsBody; may belong to a Sprite or Part.
\param anchor Anchor in this body’s local distance coordinates; default origin where optional.
\param otherAnchor Anchor in the other body’s local distance coordinates; default origin where optional.
\param minDistance Finite nonnegative minimum distance.
\param maxDistance Finite maximum distance, at least the minimum.

\return The new PhysicsConstraint handle.

\see PhysicsConstraint
*/

/**
\fn PhysicsConstraint& pdg::PhysicsBody::createGrooveJoint(PhysicsBody& other, const Point& start, const Point& end, const Point& otherAnchor)
\brief Slide an anchor along a segment on this body.

Motion along the segment remains free; its endpoints limit travel. Requires two distinct instantiated bodies in the same world. Anchors are unscaled body-local coordinates, independent of artwork scaling. Basic and Chipmunk implement the same relationship with different numerical trajectories. Endpoints own the active handle; native callers must retain it explicitly to use it after disconnection.

\param other Other instantiated PhysicsBody; may belong to a Sprite or Part.
\param start Finite segment start in this body’s local coordinates.
\param end Finite distinct segment end in this body’s local coordinates.
\param otherAnchor Anchor in the other body’s local distance coordinates; default origin where optional.

\return The new PhysicsConstraint handle.

\see PhysicsConstraint
*/

/**
\fn PhysicsConstraint& pdg::PhysicsBody::createSpring(PhysicsBody& other, const Point& anchor, const Point& otherAnchor, double restLength, double stiffness, double damping)
\brief Join anchors with a damped linear spring.

Pulls or pushes toward the rest length. Requires two distinct instantiated bodies in the same world. Anchors are unscaled body-local coordinates, independent of artwork scaling. Basic and Chipmunk implement the same relationship with different numerical trajectories. Endpoints own the active handle; native callers must retain it explicitly to use it after disconnection.

\param other Other instantiated PhysicsBody; may belong to a Sprite or Part.
\param anchor Anchor in this body’s local distance coordinates; default origin where optional.
\param otherAnchor Anchor in the other body’s local distance coordinates; default origin where optional.
\param restLength Finite nonnegative rest length.
\param stiffness Finite nonnegative force per distance unit.
\param damping Finite nonnegative force per unit relative speed.

\return The new PhysicsConstraint handle.

\see PhysicsConstraint
*/

/**
\fn PhysicsConstraint& pdg::PhysicsBody::createRotarySpring(PhysicsBody& other, double restAngle, double stiffness, double damping)
\brief Join rotations with a damped torsional spring.

Rest angle is body B rotation minus body A rotation, clockwise positive. Requires two distinct instantiated bodies in the same world. Anchors are unscaled body-local coordinates, independent of artwork scaling. Basic and Chipmunk implement the same relationship with different numerical trajectories. Endpoints own the active handle; native callers must retain it explicitly to use it after disconnection.

\param other Other instantiated PhysicsBody; may belong to a Sprite or Part.
\param restAngle Finite rest angle in radians.
\param stiffness Finite nonnegative torque per radian.
\param damping Finite nonnegative torque per radian/second.

\return The new PhysicsConstraint handle.

\see PhysicsConstraint
*/

/**
\fn PhysicsConstraint& pdg::PhysicsBody::createRotaryLimit(PhysicsBody& other, double minAngle, double maxAngle)
\brief Limit the relative angle of two bodies.

Limits apply to B rotation minus A rotation, in unwrapped radians. Requires two distinct instantiated bodies in the same world. Anchors are unscaled body-local coordinates, independent of artwork scaling. Basic and Chipmunk implement the same relationship with different numerical trajectories. Endpoints own the active handle; native callers must retain it explicitly to use it after disconnection.

\param other Other instantiated PhysicsBody; may belong to a Sprite or Part.
\param minAngle Finite minimum clockwise relative angle.
\param maxAngle Finite maximum angle, at least the minimum.

\return The new PhysicsConstraint handle.

\see PhysicsConstraint
*/

/**
\fn PhysicsConstraint& pdg::PhysicsBody::createRatchet(PhysicsBody& other, double interval, double phase = 0)
\brief Permit rotation through discrete one-way teeth.

Positive interval permits increasing B-minus-A rotation; negative interval reverses the direction. Requires two distinct instantiated bodies in the same world. Anchors are unscaled body-local coordinates, independent of artwork scaling. Basic and Chipmunk implement the same relationship with different numerical trajectories. Endpoints own the active handle; native callers must retain it explicitly to use it after disconnection.

\param other Other instantiated PhysicsBody; may belong to a Sprite or Part.
\param interval Finite nonzero signed tooth interval in radians.
\param phase Finite angular tooth offset in radians; default zero.

\return The new PhysicsConstraint handle.

\see PhysicsConstraint
*/

/**
\fn PhysicsConstraint& pdg::PhysicsBody::createGear(PhysicsBody& other, double ratio, double phase = 0)
\brief Couple rotations at a fixed ratio.

Maintains other.rotation * ratio - this.rotation = phase. Requires two distinct instantiated bodies in the same world. Anchors are unscaled body-local coordinates, independent of artwork scaling. Basic and Chipmunk implement the same relationship with different numerical trajectories. Endpoints own the active handle; native callers must retain it explicitly to use it after disconnection.

\param other Other instantiated PhysicsBody; may belong to a Sprite or Part.
\param ratio Finite nonzero signed ratio.
\param phase Finite angular phase in radians; default zero.

\return The new PhysicsConstraint handle.

\see PhysicsConstraint
*/

/**
\fn PhysicsConstraint& pdg::PhysicsBody::createMotor(PhysicsBody& other, double radiansPerSecond, double maxTorque)
\brief Drive a relative angular speed with a torque limit.

Positive speed turns B clockwise relative to A. Requires two distinct instantiated bodies in the same world. Anchors are unscaled body-local coordinates, independent of artwork scaling. Basic and Chipmunk implement the same relationship with different numerical trajectories. Endpoints own the active handle; native callers must retain it explicitly to use it after disconnection.

\param other Other instantiated PhysicsBody; may belong to a Sprite or Part.
\param radiansPerSecond Finite target B-minus-A angular speed, in radians/second.
\param maxTorque Finite nonnegative maximum torque.

\return The new PhysicsConstraint handle.

\see PhysicsConstraint
*/

/**
\fn uint32_t pdg::PhysicsBody::getConstraintCount() const
\brief Count connected constraints on this body.

The same constraint appears on both endpoint bodies.

\return Number of active connections; zero for NoPhysics.
*/

/**
\fn PhysicsConstraint& pdg::PhysicsBody::getConstraint(uint32_t index) const
\brief Read a connected constraint by list index.

Indices shift after disconnection. Out-of-range indices throw.

\param index Zero-based index into this body’s current connections.

\return Borrowed native reference to the shared constraint; JavaScript retains the handle.
*/

/**
\fn PhysicsBody& pdg::PhysicsBody::disconnect(PhysicsBody* other = nullptr)
\brief Disconnect this body’s constraints.

Retained constraint handles remain safe and report NoPhysics endpoints.

\param other Optional other endpoint; omission or null disconnects all.

\return This object, for chaining.
*/

/**
\fn Collider& pdg::Collider::setContactHandler(std::function<void(const ColliderContact&)> handler)
\brief Set the native listener for this collider's contact phases.

The listener runs synchronously after contact solving. Collider pointers in its
payload remain valid for the call; retain a handle explicitly to keep it longer.
It may remove colliders, bodies, owners or layers. Events already collected for
this frame describe the solved frame and can refer to subsequently detached
colliders. Exceptions are caught and recorded by getContactError(); a successful
dispatch clears that error. Calling the same CollisionWorld::step() recursively
from its listener is rejected.

\param handler Function receiving one borrowed contact record, or an empty
function to remove the listener. This does not change setWantsContactEvents().
\return This collider, for chaining.
\see ColliderContact, getContactError(), setWantsContactEvents()
*/
/**
\fn void pdg::CollisionWorld::step(const std::vector<Collider*>& colliders, double seconds, std::function<bool(const Collider&, const Collider&)> pairFilter)
\brief Detect and resolve a collected collider frame, then deliver contact phases.

SpriteLayer performs this automatically for its owners. A custom native loop
must advance its bodies before passing the current set of attached colliders.
Inputs are borrowed; this world retains the handles used by its current and
previous contact frames. Omitted or disabled colliders end their previous contacts.
Duplicate pointers are ignored. Filtering combines collider categories, masks,
groups, body relationships, layer permissions and the optional additional filter.
Basic response handles pairs not registered together in the native physics space.
Call this after the native solve when using Chipmunk; it does not advance that space.
Native pairs reuse the solver contact manifold, including sensors and sleeping
contacts, without repeating geometric detection. Static/static, mixed-solver and
zero-time queries retain geometric detection. Sleeping contacts continue to report
Stay with zero new impulse.

\param colliders Current attached colliders to inspect.
\param seconds Finite nonnegative step duration in seconds. Zero detects contacts
without applying basic response impulses.
\param pairFilter Optional additional pair predicate. False suppresses that pair.
Leave empty for ordinary collider filtering. The predicate must not mutate the
world; use contact listeners for changes after solving.
\see Collider::setContactHandler(), ColliderContact
*/

/**
\class pdg::Collider
\htmlonly[block]
<div class="shared-api-options">
\endhtmlonly

\anchor collider_geometry_sources
\par Geometry sources and explicit additions

| Operation | Frame/animation source | Caller-added shapes |
| --- | --- | --- |
| Sprite.setupFrameCollider / setupAnimationCollider | Selects the source and follows subsequent artwork updates | Clears previous geometry when selecting the source |
| addCircle / addCapsule / addBox / addPolygon / addImageMask | Continues updating | Adds a persistent shape in owner-local coordinates |
| removeShape | Throws for a source-controlled ID | Removes that addition only |
| setCircle / setCapsule / setBox / setPolygon / setImageMask | Stops following artwork | Replaces all geometry with the supplied shape |
| clearShapes | Stops following artwork | Removes all geometry |

Source updates preserve IDs by frame or authored box name. Source IDs may be
inactive while an animation box is absent, and return when the box reappears.
getShapeCount()/getShapeId() enumerate the currently present shapes. getShapeName()
returns the authored box name, "frame" for a frame source, or an empty string for
an explicit shape. Contacts aggregate convex pieces under each public shape ID.

\htmlonly[block]
</div>
\endhtmlonly
*/

/**
\fn Collider& pdg::Collider::setPolygon(const std::vector<Point>& vertices)
\brief Replace all geometry with one polygon.

Stops any frame/animation source after validation succeeds. Accepts the same outlines as addPolygon(). See \ref collider_geometry_sources.

\param vertices Points in perimeter order, in owner-local coordinates.

\return This Collider for chaining.
*/

/**
\fn Collider& pdg::Collider::setPolygon(const Polygon& polygon)
\brief Copy collision geometry from a Polygon.

The Polygon is copied; later edits to it do not change the collider. Concave outlines preserve their gaps through convex decomposition. See \ref collider_geometry_sources.

\param polygon A simple polygon in owner-local coordinates.

\return This Collider for chaining.
*/

/**
\fn CollisionShapeId pdg::Collider::addPolygon(const Polygon& polygon)
\brief Copy collision geometry from a Polygon.

The Polygon is copied; later edits to it do not change the collider. Concave outlines preserve their gaps through convex decomposition. See \ref collider_geometry_sources.

\param polygon A simple polygon in owner-local coordinates.

\return The stable ID of the added shape.
*/

/**
\fn Collider& pdg::Collider::setImageMask(Image& image, const Rect& localBounds, int alphaThreshold)
\brief Copy opaque image pixels into collision geometry.

Uses the entire supplied image, mapped to localBounds. Pixels with alpha at least alphaThreshold become merged convex rectangles; transparent holes and disconnected islands remain empty. Geometry is copied, so subsequent pixel edits require another call. An entirely transparent image has no contact area. Named images can reload discarded CPU pixels; unavailable pixels throw. At most 65536 convex pieces are supported. See \ref collider_geometry_sources.

\param image Image to sample; use a frame image for a single strip frame.
\param localBounds Finite rectangle with positive dimensions in owner-local coordinates.
\param alphaThreshold Integer from 1 through 255; defaults to 128.

\return This Collider for chaining.
*/

/**
\fn CollisionShapeId pdg::Collider::addImageMask(Image& image, const Rect& localBounds, int alphaThreshold)
\brief Copy opaque image pixels into collision geometry.

Uses the entire supplied image, mapped to localBounds. Pixels with alpha at least alphaThreshold become merged convex rectangles; transparent holes and disconnected islands remain empty. Geometry is copied, so subsequent pixel edits require another call. An entirely transparent image has no contact area. Named images can reload discarded CPU pixels; unavailable pixels throw. At most 65536 convex pieces are supported. See \ref collider_geometry_sources.

\param image Image to sample; use a frame image for a single strip frame.
\param localBounds Finite rectangle with positive dimensions in owner-local coordinates.
\param alphaThreshold Integer from 1 through 255; defaults to 128.

\return One stable shape ID for the complete mask.
*/

/**
\fn int pdg::Collider::getGeometrySource() const
\brief Inspect collider geometry.

The read-only source kind identifies whether artwork is supplying geometry.


\return colliderSource_Explicit, colliderSource_Frame or colliderSource_Animation.
*/

/**
\fn bool pdg::Collider::isSourceShape(CollisionShapeId shape) const
\brief Inspect collider geometry.

Unknown or currently inactive IDs throw.

\param shape An active shape ID.

