namespace pdg { /**
\fn Uint8Array pdg::MemBlock::getBytes(uint start, uint len)
\brief Copy a bounded byte range into a plain Uint8Array.

The requested length is clamped to the remaining bytes. An offset at or beyond the end returns an empty array.
\param start Zero-based byte offset.
\param len Maximum number of bytes to copy.
\return A fresh, independently owned Uint8Array.
**/ }
